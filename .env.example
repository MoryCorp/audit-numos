# Cle API Google (PageSpeed Insights) - gratuite, 25k requetes/jour
GOOGLE_API_KEY=

# Origines CORS autorisees (separees par des virgules)
CORS_ORIGINS=https://audit.numos.fr

# Token admin pour proteger le dashboard (obligatoire)
ADMIN_TOKEN=

# URL publique utilisee pour construire les liens de rapport
PUBLIC_BASE_URL=https://audit.numos.fr

# Webhook notifie a la fin de chaque phase d'audit (n8n). Laisser vide pour
# desactiver. Un audit lance avec notify=false n'envoie jamais d'evenement.
AUDIT_WEBHOOK_URL=

# Audits en phase 1 simultanes : chacun ouvre un Chromium, monter avec prudence
MAX_CONCURRENT_AUDITS=3

# Crawls SEO simultanes
MAX_CONCURRENT_CRAWLS=5

# Pages crawlees par audit en mode qualification (POST /api/audits/bulk)
LIGHT_CRAWL_LIMIT=50
